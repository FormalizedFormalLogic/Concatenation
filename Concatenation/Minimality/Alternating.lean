module

public import Concatenation.Minimality.Basic
public import Concatenation.ToFoundation.Arithmetic.Presburger

/-!
# $\mathsf{ID}$ and $\mathsf{BT}$ without right cancellation

The words without two equal adjacent letters are a model of both theories that is definable in
$(\mathbb{N}, +)$, so that its theory is decidable.
-/

@[expose] public section

namespace FFL.FirstOrder.Concatenation

open ConcatenationStructure

/--
The nonempty binary words without two equal adjacent letters, given by their first letter and
their length minus one: the semigroup generated by $0$ and $1$ with $00 = 0$ and $11 = 1$.
- [Mur22, Lemma 9]
-/
@[ext]
structure AlternatingWord where
  /-- The first letter. -/
  first : Bool
  /-- The length minus one. -/
  len : ℕ

namespace AlternatingWord

/-- The last letter. -/
def last (x : AlternatingWord) : Bool := x.first ^^ x.len.bodd

instance : Zero AlternatingWord := ⟨⟨false, 0⟩⟩

instance : One AlternatingWord := ⟨⟨true, 0⟩⟩

instance : Append AlternatingWord :=
  ⟨fun x y ↦ ⟨x.first, x.len + y.len + if x.last = y.first then 0 else 1⟩⟩

instance : LE AlternatingWord := ⟨fun x y ↦ x.first = y.first ∧ x.len ≤ y.len⟩

variable {x y z u v : AlternatingWord} {a : Bool} {α : FreeSemigroup Bool}

lemma append_def (x y : AlternatingWord) :
    x ++ y = ⟨x.first, x.len + y.len + if x.last = y.first then 0 else 1⟩ := rfl

lemma le_def : x ≤ y ↔ x.first = y.first ∧ x.len ≤ y.len := Iff.rfl

lemma letter_eq (a : Bool) : (if a then 1 else 0 : AlternatingWord) = ⟨a, 0⟩ := by
  cases a <;> rfl

@[simp]
lemma last_append (x y : AlternatingWord) : (x ++ y).last = y.last := by
  rcases x with ⟨b, n⟩
  rcases y with ⟨c, m⟩
  have aux : ∀ b c p q : Bool,
      (b ^^ (p ^^ q ^^ (if (b ^^ p) = c then 0 else 1 : ℕ).bodd)) = (c ^^ q) := by decide
  simp only [append_def, last, Nat.bodd_add]
  exact aux b c n.bodd m.bodd

protected lemma append_assoc (x y z : AlternatingWord) : (x ++ y) ++ z = x ++ (y ++ z) := by
  rw [append_def (x ++ y) z, append_def x (y ++ z), last_append]
  simp only [append_def]
  ext
  · rfl
  · simp only
    omega

lemma append_letter (x : AlternatingWord) (a : Bool) :
    x ++ (⟨a, 0⟩ : AlternatingWord) = ⟨x.first, x.len + if x.last = a then 0 else 1⟩ := rfl

lemma le_append_letter : x ≤ y ++ (⟨a, 0⟩ : AlternatingWord) ↔ x = y ++ ⟨a, 0⟩ ∨ x ≤ y := by
  rw [append_letter, AlternatingWord.ext_iff]
  simp only [le_def]
  by_cases hf : x.first = y.first
  · simp only [hf, true_and]
    split_ifs <;> omega
  · simp [hf]

lemma lt_len_append_left_or_eq (u x : AlternatingWord) : x.len < (u ++ x).len ∨ x = u ++ x := by
  rcases u with ⟨b, n⟩
  rcases x with ⟨c, m⟩
  simp only [append_def, last, AlternatingWord.mk.injEq]
  rcases n with _ | n
  · by_cases h : b = c <;> simp [h]
  · exact .inl <| by omega

lemma lt_len_append_right_or_eq (x v : AlternatingWord) : x.len < (x ++ v).len ∨ x = x ++ v := by
  simp only [append_def, AlternatingWord.ext_iff, true_and]
  split_ifs <;> omega

lemma lt_len_or_eq_of_isSubstring (h : IsSubstring x y) : x.len < y.len ∨ x = y := by
  rcases h with rfl | ⟨u, rfl⟩ | ⟨v, rfl⟩ | ⟨u, v, rfl⟩ | ⟨u, v, rfl⟩
  · exact .inr rfl
  · exact lt_len_append_left_or_eq u x
  · exact lt_len_append_right_or_eq x v
  · rcases lt_len_append_left_or_eq u x with h | h <;>
      rcases lt_len_append_right_or_eq (u ++ x) v with h' | h'
    · exact .inl <| h.trans h'
    · exact .inl <| h' ▸ h
    · exact .inl <| h ▸ h'
    · exact .inr <| h.trans h'
  · rcases lt_len_append_right_or_eq x v with h | h <;>
      rcases lt_len_append_left_or_eq u (x ++ v) with h' | h'
    · exact .inl <| h.trans h'
    · exact .inl <| h' ▸ h
    · exact .inl <| h ▸ h'
    · exact .inr <| h.trans h'

lemma last_pred (b : Bool) (n : ℕ) :
    (⟨!b, n⟩ : AlternatingWord).last = (⟨b, n + 1⟩ : AlternatingWord).last := by
  cases b <;> cases h : n.bodd <;> simp [last, h]

/-- A word of length at least two is, without its first run, the value of a suffix. -/
lemma exists_suffix_ofFreeSemigroup
    (h : 1 ≤ (ofFreeSemigroup α : AlternatingWord).len) : ∃ γ : FreeSemigroup Bool,
      γ.toList <:+ α.toList ∧ (ofFreeSemigroup γ : AlternatingWord) =
        ⟨!(ofFreeSemigroup α : AlternatingWord).first,
          (ofFreeSemigroup α : AlternatingWord).len - 1⟩ := by
  induction α using FreeSemigroup.mul_of_induction with
  | of a =>
    rw [ofFreeSemigroup_of, letter_eq] at h
    simp at h
  | mul_of α a ih =>
    rw [ofFreeSemigroup_mul_of, letter_eq, append_letter] at h ⊢
    generalize (ofFreeSemigroup α : AlternatingWord) = w at h ih ⊢
    rcases w with ⟨b, n⟩
    rcases n with _ | n
    · by_cases hl : (⟨b, 0⟩ : AlternatingWord).last = a
      · simp [hl] at h
      · use FreeSemigroup.of a
        and_intros
        · exact ⟨α.toList, rfl⟩
        · obtain rfl : a = !b := by cases a <;> cases b <;> simp_all [last]
          cases b <;> rfl
    · obtain ⟨γ, ⟨t, ht⟩, hγ⟩ := ih (by simp)
      use γ * FreeSemigroup.of a
      and_intros
      · exact ⟨t, by simp [← ht]⟩
      · rw [ofFreeSemigroup_mul_of, letter_eq, hγ, append_letter]
        simp only [Nat.add_sub_cancel, last_pred]
        split_ifs <;> simp

/-- A word shorter than the value of a string is the value of one of its substrings. -/
lemma exists_infix_ofFreeSemigroup (α : FreeSemigroup Bool) (x : AlternatingWord)
    (h : x.len < (ofFreeSemigroup α : AlternatingWord).len ∨ x = ofFreeSemigroup α) :
    ∃ γ : FreeSemigroup Bool, γ.toList <:+: α.toList ∧ x = ofFreeSemigroup γ := by
  induction α using FreeSemigroup.mul_of_induction generalizing x with
  | of a =>
    rcases h with h | rfl
    · rw [ofFreeSemigroup_of, letter_eq] at h
      simp at h
    · exact ⟨_, List.infix_refl _, rfl⟩
  | mul_of α a ih =>
    rcases h with h | rfl
    swap
    · exact ⟨_, List.infix_refl _, rfl⟩
    have hA := exists_suffix_ofFreeSemigroup (α := α * FreeSemigroup.of a)
    have mono : ∀ γ : FreeSemigroup Bool, γ.toList <:+: α.toList →
        γ.toList <:+: (α * FreeSemigroup.of a).toList := fun γ hγ ↦
      hγ.trans (List.prefix_append _ _).isInfix
    rw [ofFreeSemigroup_mul_of, letter_eq, append_letter] at h hA
    by_cases hl : (ofFreeSemigroup α : AlternatingWord).last = a
    · obtain ⟨γ, hγ, rfl⟩ := ih x <| .inl <| by simpa [hl] using h
      exact ⟨γ, mono γ hγ, rfl⟩
    · simp only [hl, ↓reduceIte] at h hA
      by_cases hlt : x.len < (ofFreeSemigroup α : AlternatingWord).len
      · obtain ⟨γ, hγ, rfl⟩ := ih x <| .inl hlt
        exact ⟨γ, mono γ hγ, rfl⟩
      · have hlen : x.len = (ofFreeSemigroup α : AlternatingWord).len := by omega
        by_cases hf : x.first = (ofFreeSemigroup α : AlternatingWord).first
        · obtain ⟨γ, hγ, e⟩ := ih x <| .inr <| AlternatingWord.ext hf hlen
          exact ⟨γ, mono γ hγ, e⟩
        · obtain ⟨γ, hγ, e⟩ := hA (by simp)
          use γ
          and_intros
          · exact hγ.isInfix
          · rw [e]
            ext
            · exact Bool.eq_not.mpr hf
            · simpa using hlen

lemma isSubstring_ofFreeSemigroup (h : IsSubstring x (ofFreeSemigroup α : AlternatingWord)) :
    ∃ γ ∈ α.substrings, x = ofFreeSemigroup γ := by
  simpa only [FreeSemigroup.mem_substrings_iff_infix] using
    exists_infix_ofFreeSemigroup α x <| lt_len_or_eq_of_isSubstring h

lemma le_ofFreeSemigroup_iff :
    x ≤ (ofFreeSemigroup α : AlternatingWord) ↔ ∃ γ ∈ α.prefixes, x = ofFreeSemigroup γ := by
  induction α using FreeSemigroup.mul_of_induction with
  | of a =>
    have : (FreeSemigroup.of a).prefixes = [FreeSemigroup.of a] := rfl
    simp [this, ofFreeSemigroup_of, letter_eq, le_def, AlternatingWord.ext_iff]
  | mul_of α a ih =>
    simp only [FreeSemigroup.mem_prefixes_mul_of, exists_eq_or_imp, ← ih]
    rw [ofFreeSemigroup_mul_of, letter_eq, le_append_letter]

lemma append_zero_ne_append_one (x y : AlternatingWord) : x ++ 0 ≠ y ++ 1 := fun h ↦ by
  have h' := congrArg last h
  rw [last_append, last_append] at h'
  exact Bool.false_ne_true h'

/--
`AlternatingWord` is a model of $\mathsf{ID}$ without right cancellation.
- [Mur22, Lemma 9]
-/
instance models_ID_diff_concatRightCancel :
    AlternatingWord↓[ℒ⌢⊑] ⊧* (𝗜𝗗 \ {concatRightCancel} : Theory ℒ⌢⊑) := ⟨by
  rintro σ ⟨h, hσ⟩
  cases h
  case equal hφ =>
    have : AlternatingWord↓[ℒ⌢⊑] ⊧* 𝗘𝗤 ℒ⌢⊑ := inferInstance
    exact models_theory_iff.mp this _ hφ
  case concatAssoc => simp [models_iff, AlternatingWord.append_assoc]
  case concatRightCancel => exact absurd rfl hσ
  case concatZeroNeConcatOne => simpa [models_iff] using append_zero_ne_append_one
  case pref α =>
    simp only [models_iff]
    simpa using fun x ↦ le_ofFreeSemigroup_iff⟩

/-- `AlternatingWord` is a model of $\mathsf{BT}$ without right cancellation. -/
instance models_BT_diff_concatRightCancel :
    AlternatingWord↓[ℒ⌢] ⊧* (𝗕𝗧 \ {concatRightCancel} : Theory ℒ⌢) := ⟨by
  rintro σ ⟨h, hσ⟩
  cases h
  case equal hφ =>
    have : AlternatingWord↓[ℒ⌢] ⊧* 𝗘𝗤 ℒ⌢ := inferInstance
    exact models_theory_iff.mp this _ hφ
  case concatAssoc => simp [models_iff, AlternatingWord.append_assoc]
  case concatRightCancel => exact absurd rfl hσ
  case concatZeroNeConcatOne => simpa [models_iff] using append_zero_ne_append_one
  case substring α =>
    simp only [models_iff]
    simpa using fun x ↦ isSubstring_ofFreeSemigroup⟩

/-- The code of a word: twice its length minus one, plus one if its first letter is $1$. -/
def code (x : AlternatingWord) : ℤ := 2 * x.len + if x.first then 1 else 0

lemma code_injective : Function.Injective code := by
  rintro ⟨a, n⟩ ⟨b, m⟩ h
  simp only [code] at h
  cases a <;> cases b <;> simp at h ⊢ <;> omega

lemma exists_code_eq_iff {z : ℤ} : (∃ x, code x = z) ↔ 0 ≤ z := by
  constructor
  · rintro ⟨x, rfl⟩
    simp only [code]
    split_ifs <;> omega
  · intro h
    use ⟨decide (z % 2 = 1), (z / 2).toNat⟩
    simp only [code, decide_eq_true_eq]
    split_ifs <;> omega

open Presburger in
/-- The graph of the concatenation of `AlternatingWord` in the integers. -/
def appendGraph : Presburger.Formula 3 :=
  let last₀ : Presburger.Formula 3 :=
    .or (.dvd true 4 (.var 1)) (.dvd true 4 (.var 1 - .ofInt 3))
  let last₁ : Presburger.Formula 3 :=
    .and (.dvd false 4 (.var 1)) (.dvd false 4 (.var 1 - .ofInt 3))
  let value (c : ℤ) : Presburger.Formula 3 := .eq (.var 0) (.var 1 + .var 2 + .ofInt c)
  .or (.and last₀ (.and (.dvd true 2 (.var 2)) (value 0))) <|
    .or (.and last₀ (.and (.dvd false 2 (.var 2)) (value 1))) <|
      .or (.and last₁ (.and (.dvd true 2 (.var 2)) (value 2)))
        (.and last₁ (.and (.dvd false 2 (.var 2)) (value (-1))))

lemma eval_appendGraph (x y z : AlternatingWord) :
    appendGraph.eval ![code z, code x, code y] ↔ x ++ y = z := by
  rcases x with ⟨a, n⟩
  rcases y with ⟨b, m⟩
  rcases z with ⟨c, l⟩
  obtain ⟨n, rfl | rfl⟩ := n.even_or_odd'
  all_goals
    simp only [appendGraph, code, append_def, last, AlternatingWord.mk.injEq]
    cases a <;> cases b <;> cases c <;> simp <;> omega

open Presburger in
/-- The definition of `AlternatingWord` in the integers, for the language of concatenation. -/
def presburgerDefinition : PresburgerDefinition ℒ⌢ where
  domain := .le (.ofInt 0) (.var 0)
  func {k} f :=
    match k, f with
    | _, .zero => .eq (.var 0) (.ofInt 0)
    | _, .one => .eq (.var 0) (.ofInt 1)
    | _, .concat => appendGraph
  rel {k} r :=
    match k, r with
    | _, .eq => .eq (.var 0) (.var 1)

lemma defines_presburgerDefinition : presburgerDefinition.Defines code where
  injective := code_injective
  domain_iff z := by simp [presburgerDefinition, exists_code_eq_iff]
  func_iff {k} f v y := by
    match k, f with
    | _, .zero =>
      have e : code ⟨false, 0⟩ = 0 := by simp [code]
      change _ ↔ (⟨false, 0⟩ : AlternatingWord) = y
      rw [← code_injective.eq_iff, eq_comm, e]
      simp [presburgerDefinition]
    | _, .one =>
      have e : code ⟨true, 0⟩ = 1 := by simp [code]
      change _ ↔ (⟨true, 0⟩ : AlternatingWord) = y
      rw [← code_injective.eq_iff, eq_comm, e]
      simp [presburgerDefinition]
    | _, .concat =>
      change appendGraph.eval (code y :> code ∘ v) ↔ v 0 ++ v 1 = y
      rw [Matrix.fun_eq_vec_two (v := code ∘ v)]
      exact eval_appendGraph (v 0) (v 1) y
  rel_iff {k} r v := by
    match k, r with
    | _, .eq =>
      change _ ↔ v 0 = v 1
      simp [presburgerDefinition, code_injective.eq_iff]

open Presburger in
/-- The prefix relation of `AlternatingWord` in the integers. -/
def prefixGraph : Presburger.Formula 2 :=
  .and (.dvd true 2 (.var 1 - .var 0)) (.le (.var 0) (.var 1))

lemma eval_prefixGraph (x y : AlternatingWord) : prefixGraph.eval ![code x, code y] ↔ x ≤ y := by
  rcases x with ⟨a, n⟩
  rcases y with ⟨b, m⟩
  simp only [prefixGraph, code, le_def]
  cases a <;> cases b <;> simp <;> omega

open Presburger in
/--
The definition of `AlternatingWord` in the integers, for the language of concatenation with the
prefix relation.
-/
def presburgerDefinitionPrefix : PresburgerDefinition ℒ⌢⊑ where
  domain := presburgerDefinition.domain
  func f :=
    match f with
    | .inl f => presburgerDefinition.func f
    | .inr f => f.elim
  rel {k} r :=
    match k, r with
    | _, .inl r => presburgerDefinition.rel r
    | _, .inr .pref => prefixGraph

lemma defines_presburgerDefinitionPrefix : presburgerDefinitionPrefix.Defines code where
  injective := code_injective
  domain_iff := defines_presburgerDefinition.domain_iff
  func_iff f v y := by
    match f with
    | .inl f => exact defines_presburgerDefinition.func_iff f v y
    | .inr f => exact f.elim
  rel_iff {k} r v := by
    match k, r with
    | _, .inl r => exact defines_presburgerDefinition.rel_iff r v
    | _, .inr .pref =>
      change prefixGraph.eval (code ∘ v) ↔ v 0 ≤ v 1
      rw [Matrix.fun_eq_vec_two (v := code ∘ v)]
      exact eval_prefixGraph (v 0) (v 1)

end AlternatingWord

/--
$\mathsf{ID}$, also called $\mathsf{C}$, without right cancellation is not essentially undecidable.
- [Mur22, Open Problem 3]
-/
theorem not_essentiallyUndecidable_ID_diff_concatRightCancel :
    ¬(𝗜𝗗 \ {concatRightCancel} : Theory ℒ⌢⊑).EssentiallyUndecidable :=
  Theory.not_essentiallyUndecidable_of_models AlternatingWord
    AlternatingWord.defines_presburgerDefinitionPrefix.decidable

/--
$\mathsf{BT}$ without right cancellation is not essentially undecidable.
- [Mur22, Open Problem 3]
-/
theorem not_essentiallyUndecidable_BT_diff_concatRightCancel :
    ¬(𝗕𝗧 \ {concatRightCancel} : Theory ℒ⌢).EssentiallyUndecidable :=
  Theory.not_essentiallyUndecidable_of_models AlternatingWord
    AlternatingWord.defines_presburgerDefinition.decidable

end FFL.FirstOrder.Concatenation
